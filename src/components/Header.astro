---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Family', href: '/about/family' },
  { label: 'Services', href: '/services' },
  { label: 'Service Locations', href: '/service-locations' },
  { label: 'Projects', href: '/projects' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact-us' },
];
---

<header>
  <nav aria-label="Main navigation">
    <a href="/" class="brand">Your Brand</a>
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    background: #111827;
    color: white;
    padding: 1rem 2rem;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .brand {
    color: white;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    color: #e5e7eb;
    text-decoration: none;
  }

  li a:hover {
    color: white;
  }

  @media (max-width: 768px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
    }

    ul {
      gap: 0.75rem;
    }
  }
</style>
