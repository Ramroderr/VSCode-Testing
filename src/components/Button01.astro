---
// Button.astro
interface Props {
  type?: "button" | "submit" | "reset";
  className?: string;
}

const { type = "button", className = "" } = Astro.props;
---

<button 
  type={type} 
  class={`btn-quote ${className}`}
>
  <slot>Get a quote!</slot>
</button>

<style>
  .btn-quote {
    background-color: #000000;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-quote:hover {
    background-color: #222222;
  }
</style>